generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator zod {
  provider                  = "zod-prisma-types"
  output                    = "../src/generated"
  createRelationValuesTypes = true
}

model Task {
  id          String   @id @default(uuid()) @map("_id")
  title       String
  description String?
  createdAt   DateTime @default(now())
}